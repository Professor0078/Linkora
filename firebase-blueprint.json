{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user account record storing owner identity, subscription plan, and moderation status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Account holder display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "plan": {
          "type": "string",
          "description": "Active subscription tier controlled by system/admin.",
          "enum": ["free", "premium"]
        },
        "status": {
          "type": "string",
          "description": "Account standing controlled by administrators.",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last account update."
        }
      },
      "required": ["uid", "email", "displayName", "plan", "status", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrator registry entry granting platform moderation and management rights.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the administrator.",
          "minLength": 3,
          "maxLength": 254
        },
        "grantedBy": {
          "type": "string",
          "description": "UID of the administrator who granted privileges.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Username": {
      "title": "Username",
      "description": "Transactional public slug reservation mapping a unique lowercase username to a user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner UID associated with this public username.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique lowercase public slug.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the associated bio page is publicly published."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when slug was claimed."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when slug record was updated."
        }
      },
      "required": ["uid", "username", "isPublished", "createdAt", "updatedAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public bio page configuration, theme customization, Linkora 2.0 contact card/lead capture settings, and metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner UID matching document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Unique public slug reserved in /usernames.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public display title on the bio page.",
          "minLength": 1,
          "maxLength": 80
        },
        "headline": {
          "type": "string",
          "description": "Optional professional role or creator headline.",
          "minLength": 0,
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "Optional city or studio location.",
          "minLength": 0,
          "maxLength": 60
        },
        "announcementText": {
          "type": "string",
          "description": "Optional top announcement notice bar on the bio page.",
          "minLength": 0,
          "maxLength": 140
        },
        "bio": {
          "type": "string",
          "description": "Short biography displayed under display name.",
          "minLength": 0,
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "description": "Data URI or HTTPS URL of profile avatar.",
          "minLength": 0,
          "maxLength": 150000
        },
        "backgroundImageUrl": {
          "type": "string",
          "description": "Data URI or HTTPS URL of optional page background image.",
          "minLength": 0,
          "maxLength": 200000
        },
        "themeId": {
          "type": "string",
          "description": "Selected built-in theme identifier (16 curated themes in v3.0).",
          "enum": [
            "minimal-white",
            "dark-pro",
            "gradient-dream",
            "creator-neon",
            "business-pro",
            "pink-aesthetic",
            "nature-green",
            "glassmorphism",
            "editorial-ivory",
            "ocean-breeze",
            "midnight-gold",
            "sunset-studio",
            "nordic-frost",
            "carbon-slate",
            "emerald-luxe",
            "cyber-aurora"
          ]
        },
        "customBgColor": {
          "type": "string",
          "description": "Optional custom hex background color override.",
          "minLength": 0,
          "maxLength": 32
        },
        "customBgGradient": {
          "type": "string",
          "description": "Optional safe predefined CSS gradient key or value.",
          "minLength": 0,
          "maxLength": 160
        },
        "customButtonColor": {
          "type": "string",
          "description": "Optional custom hex button color override.",
          "minLength": 0,
          "maxLength": 32
        },
        "customTextColor": {
          "type": "string",
          "description": "Optional custom hex text color override.",
          "minLength": 0,
          "maxLength": 32
        },
        "buttonShape": {
          "type": "string",
          "description": "Corner geometry for link buttons.",
          "enum": ["sharp", "rounded", "pill"]
        },
        "buttonStyle": {
          "type": "string",
          "description": "Surface rendering style for link buttons.",
          "enum": ["solid", "outline", "soft", "shadow", "glass"]
        },
        "fontFamily": {
          "type": "string",
          "description": "Safe predefined font token.",
          "enum": ["jakarta", "serif", "mono", "editorial", "modern"]
        },
        "avatarShape": {
          "type": "string",
          "description": "Shape of profile photo container.",
          "enum": ["circle", "rounded", "square"]
        },
        "layoutWidth": {
          "type": "string",
          "description": "Container max-width preset.",
          "enum": ["compact", "standard", "wide"]
        },
        "ctaLabel": {
          "type": "string",
          "description": "Optional featured primary CTA button label.",
          "minLength": 0,
          "maxLength": 60
        },
        "ctaUrl": {
          "type": "string",
          "description": "Optional featured primary CTA destination URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "seoTitle": {
          "type": "string",
          "description": "Custom SEO title (Premium plan feature).",
          "minLength": 0,
          "maxLength": 70
        },
        "seoDescription": {
          "type": "string",
          "description": "Custom SEO meta description (Premium plan feature).",
          "minLength": 0,
          "maxLength": 160
        },
        "isVerifiedCreator": {
          "type": "boolean",
          "description": "Official verified creator status granted exclusively by administrators."
        },
        "vcardEnabled": {
          "type": "boolean",
          "description": "Whether visitors can download a .vcf Digital Contact Card."
        },
        "vcardEmail": {
          "type": "string",
          "description": "Public contact email embedded in .vcf card.",
          "minLength": 0,
          "maxLength": 160
        },
        "vcardPhone": {
          "type": "string",
          "description": "Public contact phone embedded in .vcf card.",
          "minLength": 0,
          "maxLength": 40
        },
        "leadCaptureEnabled": {
          "type": "boolean",
          "description": "Whether the visitor message/inquiry capture box is enabled on the bio page."
        },
        "leadCaptureTitle": {
          "type": "string",
          "description": "Custom heading for the visitor inquiry/newsletter box.",
          "minLength": 0,
          "maxLength": 80
        },
        "visitorThemeSwitchEnabled": {
          "type": "boolean",
          "description": "Whether visitors can toggle Light or Dark reading surface on the public bio page."
        },
        "availabilityStatus": {
          "type": "string",
          "description": "Creator work or booking availability state.",
          "enum": ["none", "available", "booking", "busy"]
        },
        "availabilityText": {
          "type": "string",
          "description": "Short custom availability status text.",
          "minLength": 0,
          "maxLength": 90
        },
        "tipJarEnabled": {
          "type": "boolean",
          "description": "Whether the creator support or tip jar button is displayed."
        },
        "tipJarLabel": {
          "type": "string",
          "description": "Button label for creator support or tip jar.",
          "minLength": 0,
          "maxLength": 60
        },
        "tipJarUrl": {
          "type": "string",
          "description": "Validated destination URL for creator support or tip jar.",
          "minLength": 0,
          "maxLength": 500
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the bio page is live to the public."
        },
        "accountStatus": {
          "type": "string",
          "description": "Moderation status mirrored for public gatekeeping.",
          "enum": ["active", "suspended"]
        },
        "linkCount": {
          "type": "integer",
          "description": "Atomically synchronized count of links in subcollection."
        },
        "lastModifiedLinkId": {
          "type": "string",
          "description": "Link ID verified during atomic add/delete batch operations.",
          "minLength": 0,
          "maxLength": 128
        },
        "totalViews": {
          "type": "integer",
          "description": "Cumulative public profile views."
        },
        "totalClicks": {
          "type": "integer",
          "description": "Cumulative public link clicks."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "avatarUrl",
        "backgroundImageUrl",
        "themeId",
        "customBgColor",
        "customBgGradient",
        "customButtonColor",
        "customTextColor",
        "buttonShape",
        "buttonStyle",
        "fontFamily",
        "avatarShape",
        "layoutWidth",
        "ctaLabel",
        "ctaUrl",
        "seoTitle",
        "seoDescription",
        "isPublished",
        "accountStatus",
        "linkCount",
        "lastModifiedLinkId",
        "totalViews",
        "totalClicks",
        "createdAt",
        "updatedAt"
      ]
    },
    "BioLink": {
      "title": "BioLink",
      "description": "Individual destination link or rich product/showcase card belonging to a user's bio page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Link document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Owner UID matching parent profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Button label displayed to visitors.",
          "minLength": 1,
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "description": "Optional rich-card secondary description.",
          "minLength": 0,
          "maxLength": 140
        },
        "badgeText": {
          "type": "string",
          "description": "Optional quiet highlight tag (e.g., New, Popular).",
          "minLength": 0,
          "maxLength": 24
        },
        "priceLabel": {
          "type": "string",
          "description": "Optional product or service price text (e.g., $29, Free, PKR 3,500).",
          "minLength": 0,
          "maxLength": 24
        },
        "sectionTitle": {
          "type": "string",
          "description": "Optional section heading rendered directly above this link.",
          "minLength": 0,
          "maxLength": 60
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Optional compressed thumbnail image data URI or HTTPS URL.",
          "minLength": 0,
          "maxLength": 120000
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether this link renders as an emphasized spotlight card."
        },
        "embedType": {
          "type": "string",
          "description": "Optional allowlisted inline media player type.",
          "enum": ["none", "youtube", "spotify"]
        },
        "startsAt": {
          "type": "string",
          "description": "Optional ISO datetime schedule start window.",
          "minLength": 0,
          "maxLength": 32
        },
        "expiresAt": {
          "type": "string",
          "description": "Optional ISO datetime schedule expiration window.",
          "minLength": 0,
          "maxLength": 32
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether this link is pinned to the top of the public bio page."
        },
        "url": {
          "type": "string",
          "description": "Validated destination URL (https, http, mailto, tel).",
          "minLength": 4,
          "maxLength": 1000,
          "pattern": "^(https?://|mailto:|tel:).+"
        },
        "platform": {
          "type": "string",
          "description": "Platform icon category.",
          "enum": [
            "website",
            "portfolio",
            "whatsapp",
            "youtube",
            "instagram",
            "tiktok",
            "facebook",
            "linkedin",
            "x",
            "github",
            "shop",
            "email",
            "phone",
            "custom"
          ]
        },
        "isSocialIcon": {
          "type": "boolean",
          "description": "Whether to also pin in the compact social icon row."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the link is visible on the public page."
        },
        "isProfilePublished": {
          "type": "boolean",
          "description": "Denormalized publish flag enabling zero-get list rules."
        },
        "order": {
          "type": "integer",
          "description": "Sort position on the bio page."
        },
        "clicks": {
          "type": "integer",
          "description": "Cumulative click count for this link."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of link creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last link update."
        }
      },
      "required": [
        "id",
        "uid",
        "title",
        "url",
        "platform",
        "isSocialIcon",
        "enabled",
        "isProfilePublished",
        "order",
        "clicks",
        "createdAt",
        "updatedAt"
      ]
    },
    "Lead": {
      "title": "Lead",
      "description": "Visitor inquiry or subscriber lead submitted from a published Linkora 2.0 bio page.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Lead document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileUid": {
          "type": "string",
          "description": "UID of the creator receiving this lead.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitorName": {
          "type": "string",
          "description": "Visitor full name.",
          "minLength": 2,
          "maxLength": 80
        },
        "visitorEmail": {
          "type": "string",
          "format": "email",
          "description": "Visitor email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "visitorPhone": {
          "type": "string",
          "description": "Optional visitor phone or WhatsApp number.",
          "minLength": 0,
          "maxLength": 40
        },
        "message": {
          "type": "string",
          "description": "Optional inquiry message from visitor.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Creator inbox status.",
          "enum": ["new", "contacted", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when lead was submitted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when lead status was updated."
        }
      },
      "required": [
        "id",
        "profileUid",
        "visitorName",
        "visitorEmail",
        "visitorPhone",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LinkEvent": {
      "title": "LinkEvent",
      "description": "Privacy-conscious analytics event recording a profile view or link click.",
      "type": "object",
      "properties": {
        "profileUid": {
          "type": "string",
          "description": "Target profile owner UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "description": "Type of visitor interaction.",
          "enum": ["view", "click"]
        },
        "linkId": {
          "type": "string",
          "description": "Clicked link ID or empty string for profile view.",
          "minLength": 0,
          "maxLength": 128
        },
        "linkTitle": {
          "type": "string",
          "description": "Clicked link title snapshot.",
          "minLength": 0,
          "maxLength": 100
        },
        "deviceType": {
          "type": "string",
          "description": "Coarse viewport category without fingerprinting.",
          "enum": ["mobile", "tablet", "desktop"]
        },
        "referrerHost": {
          "type": "string",
          "description": "Referrer domain hostname only.",
          "minLength": 0,
          "maxLength": 120
        },
        "dateKey": {
          "type": "string",
          "description": "UTC date bucket YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the event."
        }
      },
      "required": [
        "profileUid",
        "eventType",
        "linkId",
        "linkTitle",
        "deviceType",
        "referrerHost",
        "dateKey",
        "createdAt"
      ]
    },
    "AnalyticsDaily": {
      "title": "AnalyticsDaily",
      "description": "Aggregated daily view and click counters per profile.",
      "type": "object",
      "properties": {
        "profileUid": {
          "type": "string",
          "description": "Owner UID of the tracked profile.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "description": "UTC date string YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "views": {
          "type": "integer",
          "description": "Total profile views on this date."
        },
        "clicks": {
          "type": "integer",
          "description": "Total link clicks on this date."
        },
        "lastEventId": {
          "type": "string",
          "description": "LinkEvent ID created in the same atomic batch.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last counter increment."
        }
      },
      "required": ["profileUid", "dateKey", "views", "clicks", "lastEventId", "updatedAt"]
    },
