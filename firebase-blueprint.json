          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reportedUsername": {
          "type": "string",
          "description": "Slug of the reported profile.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "description": "Abuse category.",
          "enum": ["spam", "impersonation", "phishing", "inappropriate", "other"]
        },
        "details": {
          "type": "string",
          "description": "Additional explanation from reporter.",
          "minLength": 5,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Moderation review outcome.",
          "enum": ["pending", "reviewed", "dismissed", "actioned"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of report submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of moderation review."
        }
      },
      "required": [
        "reportedUid",
        "reportedUsername",
        "reason",
        "details",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global landing page copy, plan limits, and enabled theme configuration managed by admins.",
      "type": "object",
      "properties": {
        "heroHeadline": {
          "type": "string",
          "description": "Primary hero headline on the public homepage.",
          "minLength": 5,
          "maxLength": 120
        },
        "heroSubheadline": {
          "type": "string",
          "description": "Supporting hero subtitle on the public homepage.",
          "minLength": 10,
          "maxLength": 300
        },
        "freeMaxLinks": {
          "type": "integer",
          "description": "Displayed link cap for the Free tier."
        },
        "premiumMaxLinks": {
          "type": "integer",
          "description": "Displayed link cap for the Premium tier."
        },
        "premiumPriceMonthly": {
          "type": "integer",
          "description": "Monthly Premium price in USD."
        },
        "disabledThemes": {
          "type": "array",
          "description": "List of built-in theme IDs disabled by admin.",
          "maxLength": 16
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last configuration update."
        }
      },
      "required": [
        "heroHeadline",
        "heroSubheadline",
        "freeMaxLinks",
        "premiumMaxLinks",
        "premiumPriceMonthly",
        "disabledThemes",
        "updatedAt"
      ]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Frequently asked question displayed on the public homepage and edited by admins.",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "description": "FAQ question heading.",
          "minLength": 5,
          "maxLength": 200
        },
        "answer": {
          "type": "string",
          "description": "Plain-text FAQ answer.",
          "minLength": 10,
          "maxLength": 1500
        },
        "order": {
          "type": "integer",
          "description": "Display sort order."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether this FAQ item is publicly visible."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update."
        }
      },
      "required": ["question", "answer", "order", "isPublished", "updatedAt"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Custom manual payment method configured by administrators (e.g., EasyPaisa, JazzCash, Bank Transfer, Crypto).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment method document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerName": {
          "type": "string",
          "description": "Payment service or bank name (e.g. EasyPaisa, JazzCash, Meezan Bank).",
          "minLength": 2,
          "maxLength": 80
        },
        "accountTitle": {
          "type": "string",
          "description": "Account holder title shown to users.",
          "minLength": 2,
          "maxLength": 100
        },
        "accountNumber": {
          "type": "string",
          "description": "Account number, mobile wallet number, IBAN, or address.",
          "minLength": 3,
          "maxLength": 120
        },
        "instructions": {
          "type": "string",
          "description": "Optional payment instructions displayed to upgrading users.",
          "minLength": 0,
          "maxLength": 600
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether this payment method is visible for new payment requests."
        },
        "order": {
          "type": "integer",
          "description": "Display sort order."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "providerName",
        "accountTitle",
        "accountNumber",
        "instructions",
        "isActive",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual payment verification submission created by a user and reviewed by administrators.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Payment request document identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "UID of the user requesting Premium upgrade.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the submitting user.",
          "minLength": 3,
          "maxLength": 254
        },
        "username": {
          "type": "string",
          "description": "Public slug of the submitting user.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_\\-]+$"
        },
        "methodId": {
          "type": "string",
          "description": "Referenced PaymentMethod ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "methodName": {
          "type": "string",
          "description": "Snapshot of payment method provider name at submission time.",
          "minLength": 2,
          "maxLength": 80
        },
        "amountUsd": {
          "type": "integer",
          "description": "Plan price in USD associated with this request."
        },
        "senderName": {
          "type": "string",
          "description": "Account holder name from which user sent the payment.",
          "minLength": 2,
          "maxLength": 100
        },
        "senderAccount": {
          "type": "string",
          "description": "Phone number, bank account, or wallet from which payment was sent.",
          "minLength": 2,
          "maxLength": 120
        },
        "transactionId": {
          "type": "string",
          "description": "Transaction ID (Trx ID) or bank reference number.",
          "minLength": 3,
          "maxLength": 120
        },
        "receiptDataUrl": {
          "type": "string",
          "description": "Optional compressed payment receipt screenshot data URI.",
          "minLength": 0,
          "maxLength": 160000
        },
        "userNote": {
          "type": "string",
          "description": "Optional note from user.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Manual verification status controlled by administrators.",
          "enum": ["pending", "approved", "rejected"]
        },
        "adminNote": {
          "type": "string",
          "description": "Optional verification note or rejection reason from admin.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admin review."
        }
      },
      "required": [
        "id",
        "uid",
        "userEmail",
        "username",
        "methodId",
        "methodName",
        "amountUsd",
        "senderName",
        "senderAccount",
        "transactionId",
        "receiptDataUrl",
        "userNote",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account records isolated strictly to owner and admins."
    },
    "/admins/{adminUid}": {
      "schema": "Admin",
      "description": "Trusted administrator directory controlled exclusively by existing admins."
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Unique public username reservation index atomically synced with /profiles/{userId}."
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Public bio page configurations readable publicly only when published and active."
    },
    "/profiles/{userId}/links/{linkId}": {
      "schema": "BioLink",
      "description": "Ordered links and rich showcase cards belonging to a bio page."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Visitor leads and direct inquiries isolated strictly to the receiving creator and admins."
    },
    "/linkEvents/{eventId}": {
      "schema": "LinkEvent",
      "description": "Immutable privacy-safe view and click analytics events."
    },
    "/analyticsDaily/{statId}": {
      "schema": "AnalyticsDaily",
      "description": "Daily aggregated views and clicks per profile atomically linked to /linkEvents."
    },
    "/subscriptions/{userId}": {
      "schema": "Subscription",
      "description": "User subscription status isolated per user and modifiable only by admins."
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support inquiries created by users and answered by admins."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Abuse reports against public profiles reviewed exclusively by admins."
    },
    "/platformSettings/{docId}": {
      "schema": "PlatformSettings",
      "description": "Global platform configuration and homepage content."
    },
    "/faqs/{faqId}": {
      "schema": "FaqItem",
      "description": "Public FAQ entries managed by administrators."
    },
    "/paymentMethods/{methodId}": {
      "schema": "PaymentMethod",
      "description": "Custom manual payment methods configured by admins and readable by verified users when active."
    },
    "/paymentRequests/{requestId}": {
      "schema": "PaymentRequest",
      "description": "Manual payment verification requests isolated strictly to submitting owner and admins."
    }
  }
}
